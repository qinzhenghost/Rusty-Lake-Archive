{
  "name": "rusty-lake-archive",
  "version": "0.8.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check && tsc -p tsconfig.content.json --noEmit",
    "test:data": "python tools/validate_content.py && python tools/qa_check.py && python -m unittest discover -s tests -v",
    "test": "npm run test:data && npm run qa:step04 && npm run qa:step05 && npm run qa:step06 && npm run qa:step07 && npm run qa:step08 && npm run check && npm run build",
    "qa:step04": "python tools/qa_step04.py",
    "qa:step05": "python tools/qa_step05.py",
    "qa:step06": "python tools/qa_step06.py",
    "qa:step07": "python tools/qa_step07.py",
    "qa:step08": "python tools/qa_step08.py"
  },
  "dependencies": {
    "@astrojs/react": "7.0.0",
    "astro": "7.3.3",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "6.0.3"
  }
}
