---
import I18nText from './I18nText.astro';
import type { SearchReaderLink } from '../lib/models';
interface Props {
  links: SearchReaderLink[];
  networkFocus?: string;
}
const { links, networkFocus } = Astro.props;
---
{(links.length > 0 || networkFocus) && (
  <section class="archive-jumps">
    <div class="kicker"><I18nText zh="快捷入口" en="Quick Paths" /></div>
    <h2><I18nText zh="继续探索" en="Continue Exploring" /></h2>
    <div class="archive-jump-links">
      {links.map((link) => <a href={link.route}><span><I18nText zh="剧情章节" en="Story Chapter" /></span><b><I18nText zh={link.title.zhHans} en={link.title.en} /></b><i>→</i></a>)}
      {networkFocus && <a href={'/network?focus=' + encodeURIComponent(networkFocus)}><span><I18nText zh="世界观关系网" en="Lore Network" /></span><b><I18nText zh="在关系网中定位" en="Locate in network" /></b><i>→</i></a>}
    </div>
  </section>
)}
