---
import '../styles/global.css';
import I18nText from '../components/I18nText.astro';
import LanguageToggle from '../components/LanguageToggle';

interface Props {
  title?: string;
  titleEn?: string;
  description?: string;
  descriptionEn?: string;
  active?: 'home' | 'games' | 'timeline' | 'characters' | 'network' | 'search' | 'progress' | 'about';
}
const {
  title = '锈湖档案馆',
  titleEn = 'Rusty Lake Archive',
  description = '阅读、整理与探索锈湖 / Cube Escape 世界的非官方互动剧情档案馆。',
  descriptionEn = 'An unofficial interactive story archive for reading, organizing, and exploring the world of Rusty Lake and Cube Escape.',
  active,
} = Astro.props;
const pageTitleZh = title === '锈湖档案馆' ? title : title + ' · 锈湖档案馆';
const pageTitleEn = titleEn === 'Rusty Lake Archive' ? titleEn : titleEn + ' · Rusty Lake Archive';
const nav = [
  ['games', '/games', '游戏', 'Games'],
  ['timeline', '/timeline', '时间线', 'Timeline'],
  ['characters', '/characters', '人物', 'Characters'],
  ['network', '/network', '关系网', 'Network'],
  ['search', '/search', '搜索', 'Search'],
  ['progress', '/progress', '进度', 'Progress'],
] as const;
---
<!doctype html>
<html lang="zh-CN" data-lang="zhHans" data-page-title-zh={pageTitleZh} data-page-title-en={pageTitleEn}>
  <head>
    <meta charset="utf-8" />
    <script is:inline>
      (() => {
        try {
          const saved = localStorage.getItem('rla-language-v1');
          const language = saved === 'en' ? 'en' : 'zhHans';
          document.documentElement.dataset.lang = language;
          document.documentElement.lang = language === 'en' ? 'en' : 'zh-CN';
        } catch {}
      })();
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} data-description-zh={description} data-description-en={descriptionEn} />
    <meta name="theme-color" content="#171915" />
    <meta name="color-scheme" content="light" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitleZh} />
    <meta property="og:description" content={description} />
    <meta name="twitter:card" content="summary" />
    <link rel="icon" type="image/svg+xml" href="/icon.svg" />
    <link rel="manifest" href="/site.webmanifest" />
    <title>{pageTitleZh}</title>
    <script is:inline>
      (() => {
        const applyMetadataLanguage = () => {
          const root = document.documentElement;
          const language = root.dataset.lang === 'en' ? 'en' : 'zhHans';
          const title = language === 'en' ? root.dataset.pageTitleEn : root.dataset.pageTitleZh;
          if (title) document.title = title;
          const description = document.querySelector('meta[name="description"]');
          if (description) {
            const next = language === 'en' ? description.dataset.descriptionEn : description.dataset.descriptionZh;
            if (next) description.setAttribute('content', next);
          }
        };
        applyMetadataLanguage();
        window.addEventListener('rla-language-change', applyMetadataLanguage);
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main-content"><I18nText zh="跳到正文" en="Skip to content" /></a>
    <div class="site-shell">
      <header class="topbar">
        <a class="brand" href="/" aria-label="Rusty Lake Archive">
          <strong><span data-i18n-zh>锈湖档案馆</span><span data-i18n-en>RUSTY LAKE ARCHIVE</span></strong>
          <span class="brand-sub"><span data-i18n-zh>RUSTY LAKE ARCHIVE</span><span data-i18n-en>Unofficial Lore Reader</span></span>
        </a>
        <nav class="nav" aria-label="主导航">
          {nav.map(([key, href, zh, en]) => <a class:list={[active === key && 'active']} href={href}><I18nText zh={zh} en={en} /></a>)}
        </nav>
        <div class="topbar-actions">
          <LanguageToggle client:load />
          <details class="mobile-menu">
            <summary><I18nText zh="菜单" en="Menu" /></summary>
            <nav aria-label="移动端导航">
              {nav.map(([key, href, zh, en]) => <a class:list={[active === key && 'active']} href={href}><I18nText zh={zh} en={en} /></a>)}
              <a href="/about"><I18nText zh="关于" en="About" /></a>
            </nav>
          </details>
        </div>
      </header>
      <main id="main-content"><slot /></main>
      <footer class="site-footer">
        <div><I18nText zh="锈湖档案馆 · 非官方剧情与世界观阅读器" en="RUSTY LAKE ARCHIVE · UNOFFICIAL LORE READER" /></div>
        <a href="/about"><I18nText zh="关于与版权说明" en="About & Copyright" /></a>
      </footer>
    </div>
  </body>
</html>
