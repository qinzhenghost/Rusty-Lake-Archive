---
import BaseLayout from '../layouts/BaseLayout.astro';
import I18nText from '../components/I18nText.astro';
import LoreNetwork from '../components/LoreNetwork';
import { getEntityMap, getRelations } from '../lib/content';
const relations = getRelations();
const entityMap = getEntityMap();
---
<BaseLayout title="世界观关系网" titleEn="Lore Network" active="network">
  <section class="section network-page">
    <div class="section-head">
      <div><div class="kicker"><I18nText zh="关系地图" en="Relationship Map" /></div><h1><I18nText zh="世界观关系网" en="Lore Network" /></h1></div>
      <span class="muted"><I18nText zh="只展示结构化关系，不根据视觉邻近推断关系" en="Shows structured relations only; visual proximity never implies a connection" /></span>
    </div>
    <p class="section-intro"><I18nText zh="把作品、人物、概念、地点与时间事件放进同一张可探索关系网。跨作品高剧透关系会根据“我的游玩进度”隐藏；筛选只改变视图，不修改原始数据。" en="Explore games, characters, concepts, locations, and events in one network. Cross-game spoiler-heavy relations are hidden according to your play progress; filters change only the view, not the underlying data." /></p>
    <LoreNetwork client:load relations={relations} entityMap={entityMap} />
  </section>
</BaseLayout>
