---
import BaseLayout from '../../layouts/BaseLayout.astro';
import I18nText from '../../components/I18nText.astro';
import LocalizedTitle from '../../components/LocalizedTitle.astro';
import { getCharacters } from '../../lib/content';
const characters = getCharacters();
---
<BaseLayout title="人物档案" titleEn="Character Files" active="characters">
  <section class="section">
    <div class="section-head"><div><div class="kicker"><I18nText zh="人物档案" en="Subject Files" /></div><h1><I18nText zh="人物档案" en="Character Files" /></h1></div><span class="muted"><I18nText zh="事实 / 解释 / 理论分层录入" en="Facts / interpretations / theories are recorded separately" /></span></div>
    <div class="character-grid">{characters.map((item) => <a class="character-card" href={'/characters/' + item.slug}><div class="portrait"><I18nText zh="人物档案" en="SUBJECT FILE" /></div><h3><LocalizedTitle value={item.title} /></h3><small class="muted"><span data-i18n-zh>{item.summary.zhHans}</span><span data-i18n-en>{item.summary.en}</span></small></a>)}</div>
  </section>
</BaseLayout>
