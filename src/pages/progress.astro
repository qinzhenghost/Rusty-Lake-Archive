---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProgressApp from '../components/ProgressApp';
import { getGames } from '../lib/content';
const games = getGames();
---
<BaseLayout title="我的游玩进度" active="progress">
  <section class="section"><div class="section-head"><div><div class="kicker">Spoiler Control</div><h1>我的游玩进度</h1></div><span class="muted">仅保存在本地浏览器</span></div><p class="section-intro">勾选你已经完成的作品。阅读器会据此判断人物档案中的跨作品内容是否可见；未满足条件时默认遮蔽，但允许主动展开。</p><ProgressApp client:load games={games} /></section>
</BaseLayout>
