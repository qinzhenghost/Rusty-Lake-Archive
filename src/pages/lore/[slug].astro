---
import BaseLayout from '../../layouts/BaseLayout.astro';
import DossierEntries from '../../components/DossierEntries';
import RelatedArchive from '../../components/RelatedArchive';
import { getConcepts, getEntityMap, getRelationsForRef } from '../../lib/content';
import type { EntityRef } from '../../content/schema';
import type { ArchiveEntity } from '../../lib/models';

export function getStaticPaths() {
  return getConcepts().map((entity) => ({ params: { slug: entity.slug }, props: { entity } }));
}
const { entity } = Astro.props as { entity: ArchiveEntity };
const subject: EntityRef = { type: 'concept', id: entity.id };
const relations = getRelationsForRef(subject);
const entityMap = getEntityMap();
---
<BaseLayout title={entity.title.zhHans}>
  <section class="section">
    <div class="section-head"><div><div class="kicker">Lore File</div><h1>{entity.title.zhHans}</h1></div><span class="badge">{relations.length} relations</span></div>
    <div class="detail-grid">
      <div>
        <p class="section-intro">{entity.summary.zhHans}</p>
        <DossierEntries client:load entries={entity.entries} entityMap={entityMap} />
        <RelatedArchive client:load subject={subject} relations={relations} entityMap={entityMap} />
      </div>
      <aside class="detail-card">
        <div class="kicker">Network Index</div>
        <p>概念档案不再是孤立词条。关系来源、事实/解释层级以及跨作品剧透门槛都从同一套 Relation 数据读取。</p>
        <a class="button" href={'/network?focus=concept%3A' + entity.id}>在关系网中定位</a>
      </aside>
    </div>
  </section>
</BaseLayout>
