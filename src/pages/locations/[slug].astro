---
import BaseLayout from '../../layouts/BaseLayout.astro';
import DossierEntries from '../../components/DossierEntries';
import RelatedArchive from '../../components/RelatedArchive';
import { getEntityMap, getLocations, getRelationsForRef } from '../../lib/content';
import type { EntityRef } from '../../content/schema';
import type { ArchiveEntity } from '../../lib/models';

export function getStaticPaths() {
  return getLocations().map((entity) => ({ params: { slug: entity.slug }, props: { entity } }));
}
const { entity } = Astro.props as { entity: ArchiveEntity };
const subject: EntityRef = { type: 'location', id: entity.id };
const relations = getRelationsForRef(subject);
const entityMap = getEntityMap();
---
<BaseLayout title={entity.title.zhHans}>
  <section class="section">
    <div class="section-head"><div><div class="kicker">Location File</div><h1>{entity.title.zhHans}</h1></div><span class="badge">{relations.length} relations</span></div>
    <div class="detail-grid">
      <div>
        <p class="section-intro">{entity.summary.zhHans}</p>
        <DossierEntries client:load entries={entity.entries} entityMap={entityMap} />
        <RelatedArchive client:load subject={subject} relations={relations} entityMap={entityMap} />
      </div>
      <aside class="detail-card">
        <div class="kicker">Place in the Network</div>
        <p>地点节点用于连接事件、作品与世界观空间；没有可靠年份时不会从地点关系推导时间线。</p>
        <a class="button" href={'/network?focus=location%3A' + entity.id}>在关系网中定位</a>
      </aside>
    </div>
  </section>
</BaseLayout>
