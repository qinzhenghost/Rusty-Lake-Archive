---
import BaseLayout from '../layouts/BaseLayout.astro';
import SearchApp from '../components/SearchApp';
import { getSearchDocuments } from '../lib/content';

const documents = getSearchDocuments();
---
<BaseLayout title="全站搜索" active="search">
  <section class="section search-page">
    <div class="section-head">
      <div><div class="kicker">Archive Search</div><h1>全站搜索</h1></div>
      <span class="muted">{documents.length} 条结构化索引记录</span>
    </div>
    <p class="section-intro">从一个名字、年份、地点或意象开始，直接跨作品检索剧情与 Lore。搜索结果遵循当前浏览器中的游玩进度，不会用被锁定条目的正文提前回答你的问题。</p>
    <SearchApp client:load documents={documents} />
  </section>
</BaseLayout>
