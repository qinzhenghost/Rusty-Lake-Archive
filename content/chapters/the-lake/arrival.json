          {
            "kind": "entity",
            "entity": {
              "type": "location",
              "id": "rusty-lake-cabin"
            },
            "label": "abandoned cabin"
          },
          {
            "kind": "text",
            "text": " on a small island at "
          },
          {
            "kind": "entity",
            "entity": {
              "type": "concept",
              "id": "rusty-lake"
            },
            "label": "Rusty Lake"
          },
          {
            "kind": "text",
            "text": ". No explicit year is given—only the enclosed room, the lake, and a small set of tools waiting to be used."
