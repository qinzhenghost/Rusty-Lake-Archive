    },
    {
      "id": "fall-note",
      "type": "note",
      "title": {
        "zhHans": "事实与解释",
        "en": "Fact vs. Interpretation"
      },
      "content": {
        "zhHans": [
          {
            "kind": "text",
            "text": "档案会把“画面中明确发生的事”和“这些画面意味着什么”分开记录。黑影、巨眼等意象可以关联到人物与世界观，但不会在没有证据时直接等同。"
          }
        ],
        "en": [
          {
            "kind": "text",
            "text": "The archive separates what is visibly shown from what those images might mean. Motifs such as the shadow and giant eye can be linked to lore without being treated as proven identities."
          }
        ]
      },
      "tone": "archive",
