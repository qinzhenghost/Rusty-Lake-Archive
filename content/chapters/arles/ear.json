      "type": "scene",
      "title": {
        "zhHans": "进入耳中",
        "en": "Into the Ear"
      },
      "subtitle": {
        "zhHans": "熟悉的房间开始向身体内部折叠",
        "en": "The familiar room folds inward"
      },
      "spoiler": {
        "level": "major",
        "requiredCompletedGameIds": [],
        "allowManualReveal": true
      },
      "provenance": {
        "mode": "structural-label",
