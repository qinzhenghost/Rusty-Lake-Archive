      "type": "note",
      "title": {
        "zhHans": "攻略边界",
        "en": "Walkthrough Boundary"
      },
      "content": {
        "zhHans": [
          {
            "kind": "text",
            "text": "耳内谜题包含具体称重与密码流程，本档案不会记录答案，只描述它在叙事上的空间转折。"
          }
        ],
        "en": [
          {
            "kind": "text",
            "text": "The ear sequence contains specific weighing and code puzzles. This archive omits those answers and records only the narrative transition they create."
          }
        ]
      },
