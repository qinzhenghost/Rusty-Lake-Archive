        ]
      }
    },
    {
      "id": "arles-mirror-note",
      "type": "note",
      "title": {
        "zhHans": "档案解释",
        "en": "Archive Reading"
      },
      "content": {
        "zhHans": [
          {
            "kind": "text",
            "text": "“镜像＝内在冲突”属于档案层的解释，不等同于官方对历史人物心理状态的判断。"
          }
        ],
        "en": [
          {
            "kind": "text",
            "text": "Reading the mirror as inner conflict is an archive interpretation, not an official assessment of the historical figure's mental state."
          }
        ]
      },
      "tone": "archive",
