    {
      "id": "arles-bedroom-time",
      "type": "note",
      "title": {
        "zhHans": "时间说明",
        "en": "Timeline Note"
      },
      "content": {
        "zhHans": [
          {
            "kind": "text",
            "text": "当前官方页面没有给出本作可靠的世界观年份；发布日期和推荐游玩顺序都不会替代故事年份，因此本章保持无日期。"
          }
        ],
        "en": [
          {
            "kind": "text",
            "text": "The current official page does not establish a reliable in-universe year. Release date and recommended play order are not substitutes for story chronology, so this chapter remains undated."
          }
        ]
      },
