    {
      "id": "arles-canvas-guide",
      "type": "note",
      "title": {
        "zhHans": "阅读原则",
        "en": "Reading Principle"
      },
      "content": {
        "zhHans": [
          {
            "kind": "text",
            "text": "档案只保留叙事作用与意象变化，不记录颜色答案、密码或逐步操作顺序。"
          }
        ],
        "en": [
          {
            "kind": "text",
            "text": "The archive preserves narrative function and imagery, not color solutions, passwords, or solution sequences."
          }
        ]
