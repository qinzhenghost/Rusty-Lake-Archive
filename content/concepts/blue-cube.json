      "claimKind": "fact",
      "content": {
        "zhHans": [
          {
            "kind": "text",
            "text": "Winter 1981 使用蓝色方块完成该季记忆，并由此进入可以回访早期季节的阶段。"
          }
        ],
        "en": [
          {
            "kind": "text",
            "text": "Winter 1981 uses the blue cube to complete that memory and opens the phase in which earlier seasons can be revisited."
          }
        ]
      },
